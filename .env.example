# Copia este archivo a .env.local. Los valores de abajo son los de Supabase local (npm run db:start).

# Conexión directa a Postgres para el job de sincronización (se salta RLS).
# En producción: la cadena del "Session pooler" del proyecto de Supabase.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# Token gratuito de la API SIE de Banxico: https://www.banxico.org.mx/SieAPIRest/service/v1/token
# Sin él, la sincronización no actualiza el tipo de cambio.
BANXICO_TOKEN=
